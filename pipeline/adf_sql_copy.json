{
	"name": "adf_sql_copy",
	"properties": {
		"activities": [
			{
				"name": "sql_copy_activity",
				"type": "Copy",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "SqlServerSource",
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"sink": {
						"type": "DelimitedTextSink",
						"storeSettings": {
							"type": "AzureBlobFSWriteSettings"
						},
						"formatSettings": {
							"type": "DelimitedTextWriteSettings",
							"quoteAllText": true,
							"fileExtension": ".csv"
						}
					},
					"enableStaging": false,
					"translator": {
						"type": "TabularTranslator",
						"typeConversion": true,
						"typeConversionSettings": {
							"allowDataTruncation": true,
							"treatBooleanAsNumber": false
						}
					}
				},
				"inputs": [
					{
						"referenceName": "DSSqlServer",
						"type": "DatasetReference",
						"parameters": {
							"schema": {
								"value": "@pipeline().parameters.Plschema",
								"type": "Expression"
							},
							"table": {
								"value": "@pipeline().parameters.Pltable",
								"type": "Expression"
							}
						}
					}
				],
				"outputs": [
					{
						"referenceName": "DsSinkadf",
						"type": "DatasetReference"
					}
				]
			}
		],
		"parameters": {
			"Plschema": {
				"type": "string"
			},
			"Pltable": {
				"type": "string"
			}
		},
		"annotations": [],
		"lastPublishTime": "2025-07-07T16:41:55Z"
	},
	"type": "Microsoft.DataFactory/factories/pipelines"
}